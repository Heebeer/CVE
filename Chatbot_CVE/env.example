# Copie este arquivo para ".env" e preencha. NUNCA suba o ".env" para o GitHub.

# Chave gratuita da NVD (opcional, mas recomendada): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Chave do Gemini, criada no Google AI Studio (necessária para o modo "IA generativa")
GEMINI_API_KEY=

# Opcional: modelo usado na versão com IA (padrão: gemini-3.5-flash-lite)
# LLM_MODEL=
